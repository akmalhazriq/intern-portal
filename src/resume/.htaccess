# Prevent execution of PHP files
<Files "*.php">
    Order Deny,Allow
    Deny from all
</Files>

# Prevent execution of scripts and dangerous files
<FilesMatch "\.(php|php3|php4|php5|phtml|pl|py|jsp|asp|sh|cgi|exe|bat)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Allow document files for resumes
<FilesMatch "\.(pdf|doc|docx|jpg|jpeg|png)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# Block everything else
<Files "*">
    Order Deny,Allow
    Deny from all
</Files>
